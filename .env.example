# --- Supabase -------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by the daily-horoscope job.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic -----------------------------------------------------------
# Used only server-side, to generate the daily horoscope + paid readings.
ANTHROPIC_API_KEY=

# --- Cron protection ---------------------------------------------------------
# A long random string. The daily-horoscope endpoint requires it.
CRON_SECRET=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IANA timezone the daily horoscope "day" is anchored to.
SITE_TZ=Europe/Rome

# --- Analytics (optional) --------------------------------------------------
# Your domain in Plausible (e.g. scorpiodaily.com). Leave blank to disable.
# Plausible is cookieless, so no consent banner is required.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Defaults to the
# project's property; set to an empty string to disable. GA sets cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-MK7C2CQ3Q2

# --- Error monitoring (optional) -----------------------------------------
# From your Sentry project. Leave DSN blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (set in Railway, not locally):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
